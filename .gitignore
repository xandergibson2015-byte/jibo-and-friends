# ==========================================
# Jibo and Friends - Git Ignore
# ==========================================

# Dependencies
node_modules/

# Electron / electron-builder build output
dist/
release/
out/

# Packaged application files
*.exe
*.msi
*.dmg
*.pkg
*.AppImage
*.deb
*.rpm
*.snap
*.zip

# Electron-builder generated files
*.blockmap
latest.yml
latest-mac.yml
latest-linux.yml

# Environment variables / secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Operating-system files
.DS_Store
Thumbs.db
desktop.ini

# IDE / editor files
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# Temporary files
*.tmp
*.temp
*.swp
*.swo

# Crash dumps
*.dmp

# macOS metadata
.AppleDouble
.LSOverride

# Windows installer/build leftovers
$RECYCLE.BIN/
*.cab
*.msix
*.msixbundle