{
  "name": "jibo-and-friends",
  "version": "1.0.0",
  "description": "A friendly showcase of social robots",
  "author": {
    "name": "Xander Gibson",
    "email": "xandergibson2015@gmail.com"
  },
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --publish=never",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "11.5.0",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.xanderandfriends.jiboandfriends",
    "productName": "Jibo and Friends",
    "publish": null,
    "files": [
      "**/*"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64"]
        },
        "pkg"
      ],
      "icon": "build/icon.icns",
      "minimumSystemVersion": "10.10.0",
      "category": "public.app-category.education"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icons",
      "category": "Education"
    }
  }
}
